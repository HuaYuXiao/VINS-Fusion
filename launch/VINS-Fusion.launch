<launch>
    <node pkg="tf" type="static_transform_publisher" name="map2camera_init"
          args="0 0 0 0 0 0 map camera_init 100"/>

    <node pkg="vins_fusion" type="vins_node" name="vins_estimator"
          args="$(find vins_fusion)/config/realsense_d435i/realsense_stereo_imu_config.yaml"
          output="screen" required="true" launch-prefix="gdb -ex run --args"/>

<!--    <node pkg="loop_fusion" type="loop_fusion_node" name="loop_fusion_node"-->
<!--          args="$(find vins_fusion)/config/realsense_d435i/realsense_stereo_imu_config.yaml"-->
<!--          output="screen" required="true" launch-prefix="gdb -ex run &#45;&#45;args"/>-->
</launch>
